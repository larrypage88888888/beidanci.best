{
  "name": "@app/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hono Worker：REST API + 权威调度 + Cron 物化",
  "scripts": {
    "dev": "wrangler dev --local --port 8799",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "gen:seed": "node scripts/gen-seed-sql.mjs",
    "db:migrate:local": "wrangler d1 execute wordflow-db --local --file=../../packages/db/migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute wordflow-db --local --file=../../packages/db/migrations/0002_seed_cet4.sql"
  },
  "dependencies": {
    "@app/core": "workspace:*",
    "@app/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.125.0"
  }
}
